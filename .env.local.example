# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real keys.
# Production checkout fails closed when required credentials are missing.
# ---------------------------------------------------------------------------

# Public site URL (used for Razorpay callback + canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Used by admin actions + webhook.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (Dashboard → Settings → API Keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when you create the webhook (Dashboard → Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=
# Local development only. Never enable this in production.
CHECKOUT_DEMO_MODE=false

# --- Interakt (Developer Settings → API Key) ---
INTERAKT_API_KEY=
# One approved delivery template per buyer language. By default the body blanks
# are {{1}} customer name, {{2}} product title, {{3}} secure order link.
# INTERAKT_TEMPLATE_BODY_<LANG> lists the blanks in order from:
# name, product, link (order page), books (/ebooks page).
# INTERAKT_TEMPLATE_BUTTON_<LANG> fills a URL button's {{1}} (one of those
# keys, or literal text); leave empty when the template has no such button.
# INTERAKT_TEMPLATE_HEADER_<LANG>=document when the template has a Document
# header — the order's PDF is then attached to the message.
# Example for the old site's payment_sucess_pdf_v2 (PDF + {{1}} book name):
#   INTERAKT_TEMPLATE_NAME_MR=payment_sucess_pdf_v2
#   INTERAKT_TEMPLATE_HEADER_MR=document
#   INTERAKT_TEMPLATE_BODY_MR=product
INTERAKT_TEMPLATE_NAME_MR=
INTERAKT_TEMPLATE_LANGUAGE_MR=mr
INTERAKT_TEMPLATE_HEADER_MR=
INTERAKT_TEMPLATE_BODY_MR=name,product,link
INTERAKT_TEMPLATE_BUTTON_MR=
INTERAKT_TEMPLATE_NAME_HI=
INTERAKT_TEMPLATE_LANGUAGE_HI=hi
INTERAKT_TEMPLATE_NAME_EN=
INTERAKT_TEMPLATE_LANGUAGE_EN=en
# "Payment not completed" reminder, sent once by the reconcile cron to buyers
# whose payment failed (needs migration 005). Body blanks: {{1}} name,
# {{2}} product title, {{3}} book page link. Empty = reminders off.
INTERAKT_REMINDER_TEMPLATE_NAME=
INTERAKT_REMINDER_TEMPLATE_LANGUAGE=mr
# Set once a Hindi/English version of the same template is approved
# (otherwise those buyers get the Marathi version).
INTERAKT_REMINDER_TEMPLATE_LANGUAGE_HI=
INTERAKT_REMINDER_TEMPLATE_LANGUAGE_EN=
PAYMENT_REMINDER_DELAY_MINUTES=30

# --- Orders & downloads ---
# Signs /order and download links. Random, >= 32 chars (openssl rand -hex 32).
# Changing it invalidates every customer's saved order link.
ORDER_ACCESS_SECRET=
# Per-order limits (optional)
DOWNLOAD_LIMIT=30
WHATSAPP_SEND_LIMIT=3
# Send the order link to the phone entered in Razorpay checkout automatically
AUTO_WHATSAPP_ON_PAYMENT=false

# --- Media proxy — build-time ---
# "true" serves book images + preview PDFs as /media/... from this domain so
# Cloudflare caches them in India. Only turn on behind Cloudflare (production);
# leave empty locally / on hosts without a CDN.
NEXT_PUBLIC_MEDIA_PROXY=

# --- Meta (Facebook) Pixel — build-time, comma-separated pixel IDs ---
# Events: PageView, ViewContent (book page), InitiateCheckout (Buy), Purchase.
# Never loaded on /order, /my-books or /dashboard. Empty = pixel off.
NEXT_PUBLIC_META_PIXEL_IDS=

# --- Cloudflare (optional: purge cache when products change) ---
# API token with only "Zone → Cache Purge" permission for this zone.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# --- Payment reconciliation (optional locally) ---
# Protects POST /api/cron/reconcile. >= 32 chars (openssl rand -hex 32).
CRON_SECRET=

# --- Admin ---
# Comma-separated emails allowed into /dashboard (matched against Supabase Auth)
ADMIN_EMAILS=
