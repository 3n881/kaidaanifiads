# ---------------------------------------------------------------------------
# Runtime secrets for the app containers. Copy to /opt/kaf/app.env on EVERY
# server (identical values), then: chmod 600 /opt/kaf/app.env
# Never commit the real file.
# ---------------------------------------------------------------------------

# Public values (also baked into the image at build time — keep identical).
# Staging: https://new.kaydyachaanifayddyacha.com until switch day.
# (NEXT_PUBLIC_META_PIXEL_IDS and NEXT_PUBLIC_MEDIA_PROXY are build-time only:
#  GitHub variables, not here.)
NEXT_PUBLIC_SITE_URL=https://kaydyachaanifayddyacha.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only)
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (live keys in production, test keys on staging)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Order links — same value on every server, never change after launch
ORDER_ACCESS_SECRET=
DOWNLOAD_LIMIT=30
WHATSAPP_SEND_LIMIT=3
# Send the PDF on WhatsApp from the webhook right after payment
AUTO_WHATSAPP_ON_PAYMENT=true

# Interakt WhatsApp (same values as on Replov; see docs/HANDOFF.md §8)
INTERAKT_API_KEY=
# PDF delivery: template with a Document header (the PDF) and {{1}} = book name
INTERAKT_TEMPLATE_NAME_MR=payment_sucess_pdf_v2
INTERAKT_TEMPLATE_LANGUAGE_MR=mr
INTERAKT_TEMPLATE_HEADER_MR=document
INTERAKT_TEMPLATE_BODY_MR=product
INTERAKT_TEMPLATE_BUTTON_MR=
# Hindi buyers use the same template (language mr) until a Hindi version is approved
INTERAKT_TEMPLATE_NAME_HI=payment_sucess_pdf_v2
INTERAKT_TEMPLATE_LANGUAGE_HI=mr
INTERAKT_TEMPLATE_HEADER_HI=document
INTERAKT_TEMPLATE_BODY_HI=product
INTERAKT_TEMPLATE_NAME_EN=
INTERAKT_TEMPLATE_LANGUAGE_EN=en
# "Payment not completed" reminder, sent once by the reconcile cron
# ({{1}} name, {{2}} book, {{3}} link). Empty name = reminders off.
INTERAKT_REMINDER_TEMPLATE_NAME=pending_followup_v2
INTERAKT_REMINDER_TEMPLATE_LANGUAGE=mr
INTERAKT_REMINDER_TEMPLATE_LANGUAGE_HI=
INTERAKT_REMINDER_TEMPLATE_LANGUAGE_EN=
PAYMENT_REMINDER_DELAY_MINUTES=30

# Cloudflare cache purge (token with only Zone → Cache Purge)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Payment reconciliation sweep (/api/cron/reconcile). >= 32 chars,
# same value as the GitHub secret CRON_SECRET. openssl rand -hex 32
CRON_SECRET=

# Admin dashboard allowlist
ADMIN_EMAILS=

# Must stay false in production
CHECKOUT_DEMO_MODE=false
