# ---------------------------------------------------------------------------
# Origin web server. Only Cloudflare talks to this box (Lightsail firewall),
# so TLS uses a Cloudflare Origin CA certificate (SSL mode: Full (strict)).
# ---------------------------------------------------------------------------
{
	# Certificates come from Cloudflare Origin CA, not Let's Encrypt.
	auto_https disable_certs

	servers {
		# Real visitor IP in logs. Cloudflare ranges: https://www.cloudflare.com/ips/
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# new. = staging hostname used before switch day (docs/go-live-plan.md).
# The Origin certificate covers *.kaydyachaanifayddyacha.com.
kaydyachaanifayddyacha.com, www.kaydyachaanifayddyacha.com, new.kaydyachaanifayddyacha.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	# Admin localized PDF + preview uploads (kept below Cloudflare's 100 MB ceiling).
	request_body {
		max_size 95MB
	}

	# During a deploy app1 already runs the new release while app2 is still on
	# the old one (~1 min). A page from one can ask the other for its CSS/JS,
	# which only exists in its own image → 404 → unstyled page. So a static
	# file that one container doesn't have is fetched from the other.
	@static path /_next/static/*
	handle @static {
		reverse_proxy app1:3000 app2:3000 {
			lb_policy first
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 10s
			health_uri /api/health
			health_interval 5s
			health_timeout 3s

			@missing status 404
			handle_response @missing {
				reverse_proxy app2:3000 app1:3000 {
					lb_policy first
					lb_try_duration 5s
					lb_try_interval 250ms
					health_uri /api/health
					health_interval 5s
					health_timeout 3s
				}
			}
		}
	}

	handle {
		reverse_proxy app1:3000 app2:3000 {
			lb_policy round_robin
			# If one container is restarting (deploy) or down, retry the other.
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 10s
			health_uri /api/health
			health_interval 5s
			health_timeout 3s
		}
	}

	log {
		output stdout
		format console
	}
}
